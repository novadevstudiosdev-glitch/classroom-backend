# ========================================
# CLASSROOM BACKEND — Variables de entorno
# ========================================
# Copiá este archivo: cp .env.example .env
# Las variables marcadas con [REQUERIDO] son obligatorias para levantar la app.
# Las marcadas con [OPCIONAL] tienen un fallback o pueden omitirse en desarrollo.
#
# ----------------
# APLICACIÓN
# ----------------
NODE_ENV=development              # development | production | test
PORT=3000                         # [OPCIONAL] Puerto del servidor (default: 3000)
API_PREFIX=api                    # [OPCIONAL] Prefijo global de rutas (default: api)

# ----------------
# SWAGGER
# ----------------
SWAGGER_ENABLED=true              # [OPCIONAL] Habilitar Swagger UI (default: true)
SWAGGER_USER=swagger              # [OPCIONAL] Usuario de Basic Auth para Swagger
SWAGGER_PASSWORD=                 # [OPCIONAL] Si se define, Swagger queda protegido con Basic Auth

# ----------------
# BASE DE DATOS (Supabase)
# ----------------
# Podés usar DATABASE_URL o las variables individuales — no hace falta ambas.
DATABASE_URL=                     # [REQUERIDO] Connection string completo (recomendado)
DATABASE_HOST=                    # [REQUERIDO si no usás DATABASE_URL]
DATABASE_PORT=6543                # [REQUERIDO si no usás DATABASE_URL]
DATABASE_USER=                    # [REQUERIDO si no usás DATABASE_URL]
DATABASE_PASSWORD=                # [REQUERIDO si no usás DATABASE_URL]
DATABASE_NAME=postgres            # [REQUERIDO si no usás DATABASE_URL]

# ----------------
# JWT
# ----------------
JWT_SECRET=                       # [REQUERIDO] Secret largo y aleatorio (mín. 64 chars)
JWT_EXPIRES_IN=15m                 # [REQUERIDO] Duración del access token (ej: 15m, 1h, 7d)
JWT_REFRESH_SECRET=               # [REQUERIDO] Secret distinto al JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d         # [REQUERIDO] Duración del refresh token (ej: 7d, 30d)

# ----------------
# GOOGLE OAUTH
# ----------------
GOOGLE_CLIENT_ID=                 # [OPCIONAL] Client ID de Google Cloud Console
GOOGLE_CLIENT_SECRET=             # [OPCIONAL] Client Secret de Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback  # [OPCIONAL]

# ----------------
# RECAPTCHA
# ----------------
RECAPTCHA_SECRET_KEY=             # [OPCIONAL] Si no se define, reCAPTCHA se omite en desarrollo

# ----------------
# EMAIL (Resend)
# ----------------
RESEND_API_KEY=                   # [REQUERIDO en producción] API key de resend.com
RESEND_FROM=noreply@tudominio.com # [OPCIONAL] Email remitente (default interno del servicio)

# ----------------
# REDIS (Upstash)
# ----------------
# Requerido para que el logout invalide tokens de forma inmediata.
# Sin Redis, el logout funciona pero el token sigue válido hasta que expira.
REDIS_URL=                        # [OPCIONAL] URL completa de Upstash (rediss://...)
REDIS_HOST=                       # [OPCIONAL] Host de Railway Redis (sin TLS)
REDIS_PORT=6379                   # [OPCIONAL] Puerto de Railway Redis
REDIS_PASSWORD=                   # [OPCIONAL] Password de Railway Redis

# ----------------
# FRONTEND
# ----------------
FRONTEND_URL=http://localhost:3001  # [REQUERIDO] URL del frontend para CORS y redirects OAuth
